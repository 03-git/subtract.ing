#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${1:-}"
LANG_FLAG="${2:---lang}"
LANG_VAL="${3:-en}"
[ "$LANG_FLAG" = "--lang" ] && [ -n "$LANG_VAL" ] && LANG="$LANG_VAL" || LANG="en"

DATA_DIR="$HOME/.subtract/clinical"
LOG_DIR="$HOME/.subtract/log/clinical"
mkdir -p "$LOG_DIR"

DATA="$DATA_DIR/$PROGRAM.json"
if [ ! -f "$DATA" ]; then
    echo "unknown program: $PROGRAM"
    echo "available: $(ls "$DATA_DIR"/*.json 2>/dev/null | xargs -I{} basename {} .json | tr '\n' ' ')"
    exit 1
fi

LOG="$LOG_DIR/${PROGRAM}-$(date +%Y%m%d-%H%M%S).jsonl"
CORRECT=0
INCORRECT=0
TOTAL=0

speak() {
    espeak-ng -s 140 -p 50 "$1" 2>/dev/null &
}

dims() {
    COLS=$(tput cols 2>/dev/null || echo 80)
    ROWS=$(tput lines 2>/dev/null || echo 24)
}

center() {
    local text="$1"
    local len=${#text}
    local pad=$(( (COLS - len) / 2 ))
    [ "$pad" -lt 0 ] && pad=0
    printf '%*s%s' "$pad" '' "$text"
}

vpad() {
    local lines="${1:-6}"
    local top=$(( (ROWS - lines) / 3 ))
    [ "$top" -lt 1 ] && top=1
    printf "%$(( top ))s" '' | tr ' ' $'\n'
}

fillscreen() {
    local bg="$1" fg="$2" text="$3"
    local blank
    blank=$(printf '%*s' "$COLS" '')
    printf '\033[%s;%sm' "$fg" "$bg"
    for ((r=0; r<ROWS; r++)); do printf '%s\n' "$blank"; done
    tput cup $(( ROWS / 2 )) 0
    center "$text"
    printf '\033[0m'
    tput cup $(( ROWS - 1 )) 0
}

show_trial() {
    local icon="$1" question="$2"
    clear
    dims
    vpad 8
    printf '\n'
    center "$icon"
    printf '\n\n\n'
    printf '\033[1;97m'
    center "$question"
    printf '\033[0m\n\n\n'
}

show_prompt() {
    local text="$1"
    printf '\033[1;93m'
    center "$text "
    printf '\033[0m'
}

show_correct() {
    dims
    fillscreen "42" "1;97" "CORRECT"
    sleep 2
}

show_incorrect() {
    local hint="${1:-}"
    dims
    if [ -n "$hint" ]; then
        fillscreen "41" "1;97" "INCORRECT   $hint"
    else
        fillscreen "41" "1;97" "INCORRECT"
    fi
    sleep 2
}

clear
dims
case "$PROGRAM" in
    yes-no)
        COUNT=$(jq length "$DATA")
        ORDER=$(seq 0 $((COUNT-1)) | shuf)
        for i in $ORDER; do
            [ "$LANG" = "es" ] && Q=$(jq -r ".[$i].es" "$DATA") || Q=$(jq -r ".[$i].en" "$DATA")
            ICON=$(jq -r ".[$i].icon" "$DATA")
            ANSWER=$(jq -r ".[$i].a" "$DATA")

            show_trial "$ICON" "$Q"
            speak "$Q"

            while true; do
                show_prompt "yes or no? (r=replay) "
                read -r RESPONSE
                RESPONSE=$(printf '%s' "$RESPONSE" | tr '[:upper:]' '[:lower:]')
                [ "$RESPONSE" = "r" ] && { show_trial "$ICON" "$Q"; speak "$Q"; continue; }
                break
            done
            TOTAL=$((TOTAL+1))

            if [ "$RESPONSE" = "$(printf '%s' "$ANSWER" | tr '[:upper:]' '[:lower:]')" ]; then
                show_correct
                CORRECT=$((CORRECT+1))
                RESULT="correct"
            else
                show_incorrect "$ANSWER"
                INCORRECT=$((INCORRECT+1))
                RESULT="incorrect"
            fi

            printf '{"time":"%s","program":"%s","stimulus":"%s","response":"%s","expected":"%s","result":"%s"}\n' \
                "$(date -Iseconds)" "$PROGRAM" "$Q" "$RESPONSE" "$ANSWER" "$RESULT" >> "$LOG"
        done
        ;;
    wh-flashcards)
        COUNT=$(jq length "$DATA")
        ORDER=$(seq 0 $((COUNT-1)) | shuf)
        for i in $ORDER; do
            if [ "$LANG" = "es" ]; then
                Q=$(jq -r ".[$i].es" "$DATA"); A=$(jq -r ".[$i].a_es" "$DATA")
            else
                Q=$(jq -r ".[$i].en" "$DATA"); A=$(jq -r ".[$i].a_en" "$DATA")
            fi
            ICON=$(jq -r ".[$i].icon" "$DATA")

            show_trial "$ICON" "$Q"
            speak "$Q"

            show_prompt "answer: "
            read -r RESPONSE
            TOTAL=$((TOTAL+1))

            printf '\n\n'
            printf '\033[1;97m'
            center "→ $A"
            printf '\033[0m\n\n'
            show_prompt "correct? (y/n) "
            read -r JUDGE

            if [ "$JUDGE" = "y" ]; then
                show_correct
                CORRECT=$((CORRECT+1))
                RESULT="correct"
            else
                show_incorrect
                INCORRECT=$((INCORRECT+1))
                RESULT="incorrect"
            fi

            printf '{"time":"%s","program":"%s","stimulus":"%s","response":"%s","expected":"%s","result":"%s"}\n' \
                "$(date -Iseconds)" "$PROGRAM" "$Q" "$RESPONSE" "$A" "$RESULT" >> "$LOG"
        done
        ;;
    sight-words-spanish)
        COUNT=$(jq length "$DATA")
        ORDER=$(seq 0 $((COUNT-1)) | shuf)
        for i in $ORDER; do
            ES=$(jq -r ".[$i].es" "$DATA")
            EN=$(jq -r ".[$i].en" "$DATA")
            ICON=$(jq -r ".[$i].icon" "$DATA")

            show_trial "$ICON" "$ES"
            speak "$ES"

            show_prompt "what does it mean? "
            read -r RESPONSE
            TOTAL=$((TOTAL+1))

            printf '\n\n'
            printf '\033[1;97m'
            center "→ $EN"
            printf '\033[0m\n\n'
            show_prompt "correct? (y/n) "
            read -r JUDGE

            if [ "$JUDGE" = "y" ]; then
                show_correct
                CORRECT=$((CORRECT+1))
                RESULT="correct"
            else
                show_incorrect
                INCORRECT=$((INCORRECT+1))
                RESULT="incorrect"
            fi

            printf '{"time":"%s","program":"%s","stimulus":"%s","response":"%s","expected":"%s","result":"%s"}\n' \
                "$(date -Iseconds)" "$PROGRAM" "$ES" "$RESPONSE" "$EN" "$RESULT" >> "$LOG"
        done
        ;;
    one-step)
        CATEGORIES=$(jq -r 'keys[]' "$DATA")
        for cat in $CATEGORIES; do
            COUNT=$(jq ".\"$cat\" | length" "$DATA")
            ORDER=$(seq 0 $((COUNT-1)) | shuf)
            for i in $ORDER; do
                [ "$LANG" = "es" ] && Q=$(jq -r ".\"$cat\"[$i].es" "$DATA") || Q=$(jq -r ".\"$cat\"[$i].en" "$DATA")
                ICON=$(jq -r ".\"$cat\"[$i].icon" "$DATA")

                show_trial "$ICON" "$Q"
                speak "$Q"

                show_prompt "did they do it? (y/n) "
                read -r JUDGE
                TOTAL=$((TOTAL+1))

                if [ "$JUDGE" = "y" ]; then
                    show_correct
                    CORRECT=$((CORRECT+1))
                    RESULT="correct"
                else
                    show_incorrect
                    INCORRECT=$((INCORRECT+1))
                    RESULT="incorrect"
                fi

                printf '{"time":"%s","program":"%s","category":"%s","stimulus":"%s","response":"%s","result":"%s"}\n' \
                    "$(date -Iseconds)" "$PROGRAM" "$cat" "$Q" "$JUDGE" "$RESULT" >> "$LOG"
            done
        done
        ;;
esac

clear
dims
vpad 6
printf '\033[1;97m'
center "Session complete"
printf '\033[0m\n\n\n'
printf '\033[1;32m'
center "correct: $CORRECT"
printf '\033[0m\n\n'
printf '\033[1;31m'
center "incorrect: $INCORRECT"
printf '\033[0m\n\n'
printf '\033[1;97m'
center "Total: $TOTAL"
printf '\033[0m\n\n'
