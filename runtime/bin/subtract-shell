#!/usr/bin/env bash
set -uo pipefail
export PATH="$HOME/.subtract/bin:$HOME/.subtract:$PATH"

chafa --format=sixel --size=10 ~/subtract.ing/favicon.png 2>/dev/null
printf '\n  what files are here\n  what time is it\n  what programs can the kids run\n  godzilla\n  more computer\n'

while true; do
    printf '\n\033[1;32m%s@%s\033[0m:\033[1;34m~\033[0m$ ' "$(whoami)" "$(hostname)"
    read -r line || break
    [ -z "$line" ] && continue
    lower=$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        exit|quit) break ;;
        "more computer"|"new screen"|"another screen")
            tmux new-window 2>/dev/null ;;
        subtract-program*) $line ;;
        *yes*no*) subtract-program yes-no ;;
        *questions*|*flashcard*) subtract-program wh-flashcards ;;
        *words*|*palabras*) subtract-program sight-words-spanish ;;
        *follow*|*directions*) subtract-program one-step ;;
        *practicar*) subtract-program yes-no --lang es ;;
        play-rom*) play-rom "${lower#play-rom }" ;;
        play*) play-rom "${lower#play }" ;;
        *random*game*) retroarch -L /usr/lib/x86_64-linux-gnu/libretro/nestopia_libretro.so "$(ls /home/media/Games/NESroms/USA/*.nes | shuf -n 1)" ;;
        help) printf '  what files are here\n  what time is it\n  what programs can the kids run\n  godzilla\n  more computer\n' ;;
        *) hosuni "$line" ;;
    esac
done
